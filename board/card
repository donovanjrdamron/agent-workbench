#!/usr/bin/env python3
"""Tiny CLI so Claude sessions can keep the work board honest.
  card list                      active cards (not Done)
  card start <id> [focus]        move card to Orchestrating (or Deep focus with "focus")
  card new "<title>" <brand> [focus]   create a card already in progress
  card done <id>                 the task looks finished: marks the card "Ready for review". It stays where it is and
                                 its sessions stay open; only the user moves a card to Done (that closes its tabs).
  card link <id> "<label>" <url> add a link to the card's notes (skips duplicates)
  card studio <id> [board|ads|email|web]
                                 the card's Studio board (plan + designs): prints its name and the folder for its files.
                                 Design work (static ads, emails, web pages) goes on the brand's permanent board, in a
                                 folder and section of its own; it is picked from the title, or say which: ads|email|web.
                                 With a board name: link the card to that existing Studio board instead.
  card remind <id|-> <when> "<what>"
                                 a follow-up or recurring job the user asked for ("hit me back in 30 min", "every morning
                                 check spend"). when: 30m, 2h, 5:30pm, tomorrow 9am, every 30m, every day 9am, every weekday 9am.
                                 It resumes this conversation in the background when due (even after this session closes
                                 or the card is Done) and the user gets the report. Never use your own timers for this.
  card reminders [id]            the automations (all, or one card's)      card unremind <automation id>   remove one
  card boards                    the Studio boards kept for good (ad creatives, libraries...) and the cards on each.
                                 New work that belongs on one of them goes there: card studio <id> "<board>"
"""
import json, os, re, sys, time, fcntl
DATA = os.path.join(os.path.dirname(os.path.realpath(__file__)), "board.json")

def claude_pid():
    """The Claude Code process that ran this command (walk up the process tree)."""
    import subprocess
    pid = os.getppid()
    for _ in range(12):
        try:
            out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        except Exception:
            return None
        if not out: return None
        ppid, comm = out.split(None, 1)
        if comm.strip().endswith("claude"): return str(pid)
        pid = int(ppid)
        if pid <= 1: return None
    return None

def link(c):
    """Remember which Claude session/terminal is working on this card. A card keeps every session that worked on it."""
    pid, term = claude_pid(), os.environ.get("ORCA_TERMINAL_HANDLE", "")
    if not pid: return
    a = {"pid": pid, "terminal": term, "linked": int(time.time())}
    try:
        rec = json.load(open(os.path.expanduser(f"~/.claude/waiting/.sessions/{pid}.json")))
        if rec.get("transcript"): a["transcript"] = rec["transcript"]; a["sid"] = rec.get("sid", "")
        if rec.get("cwd"): a["cwd"] = rec["cwd"]
    except Exception: pass
    agents = [x for x in (c.get("agents") or ([c["agent"]] if c.get("agent") else [])) if str(x.get("pid")) != pid]
    c["agents"] = (agents + [a])[-12:]
    c["agent"] = a

def api(method, path, body=None):
    import urllib.request, urllib.error
    port = os.environ.get("BOARD_PORT", "4477")
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", method=method, data=json.dumps(body).encode() if body is not None else None)
    try: return json.loads(urllib.request.urlopen(req, timeout=20).read() or b"{}")
    except urllib.error.HTTPError as e: return json.loads(e.read() or b"{}") | {"_code": e.code}

def remind(a):
    """card remind <id|-> <when> "<what to do and report>"   card reminders [id]   card unremind <automation id>"""
    if a[0] == "remind":
        if len(a) < 4: print('usage: card remind <card id> <when> "<what to do, and what to report back>"\n  when: 30m, 2h, 5:30pm, tomorrow 9am, every 30m, every day 9am, every weekday 9am'); return 1
        r = api("POST", "/api/automations", {"card": "" if a[1] == "-" else a[1], "when": a[2], "prompt": " ".join(a[3:]), "pid": claude_pid() or ""})
        if r.get("error"): print("not set:", r["error"]); return 1
        x = r["automation"]
        import datetime as dt
        at = dt.datetime.fromtimestamp(x["next"]).strftime("%a %-I:%M %p") if x.get("next") else "?"
        print(f'{x["id"]} set: {x["every"]}, next {at}' + (f' (card: {x["card_title"]})' if x.get("card_title") else ''))
        print("  It runs in the background by resuming this conversation, even after this session closes or the card is Done.")
        print("  The user sees the result in the board's Automations tab and as a notification.")
        return 0
    if a[0] == "reminders":
        items = api("GET", "/api/automations").get("items", [])
        if len(a) > 1: items = [x for x in items if x.get("card") == a[1]]
        import datetime as dt
        for x in items:
            at = dt.datetime.fromtimestamp(x["next"]).strftime("%a %-I:%M %p") if x.get("next") else "-"
            print(f'{x["id"]} | {x["status"]} | {x["every"]} | next {at} | {x.get("card_title") or ""} | {x["prompt"][:80]}')
        if not items: print("No automations.")
        return 0
    if len(a) < 2: print("usage: card unremind <automation id>"); return 1
    r = api("POST", f"/api/automations/{a[1]}/delete")
    print("removed" if r.get("ok") else r.get("error", "failed")); return 0 if r.get("ok") else 1

def studio_board(cid, name=None):
    """Make (or link) the card's Studio board through the board server, which knows how to reach Studio."""
    import urllib.request, urllib.error
    port = os.environ.get("BOARD_PORT", "4477")
    kind = name if name in ("ads", "email", "web") else None
    if name and not kind:
        with open(DATA + ".lock", "w") as lk:
            fcntl.flock(lk, fcntl.LOCK_EX)
            b = json.load(open(DATA))
            c = next((c for c in b["cards"] if c["id"] == cid), None)
            if not c: print("no card", cid); return 1
            c["studio"] = name
            import shutil; shutil.copy2(DATA, DATA + ".bak")
            tmp = DATA + ".tmp"; json.dump(b, open(tmp, "w"), indent=1); os.replace(tmp, DATA)
    try:
        r = json.loads(urllib.request.urlopen(urllib.request.Request(f"http://127.0.0.1:{port}/api/studio/{cid}" + (f"?kind={kind}" if kind else ""), method="POST"), timeout=90).read())
    except urllib.error.HTTPError as e:
        print("Studio:", json.loads(e.read() or b"{}").get("error", e.code)); return 1
    except Exception as e:
        print("work board server not reachable:", e); return 1
    print(f'{cid} -> Studio board "{r["board"]}"  {r["url"]}')
    if r.get("permanent"):
        print(f'  permanent board: put this task\'s design files ONLY in its own folder (it becomes its section):\n  {r["folder"]}')
    print(f'  read its plan: studio plan "{r["board"]}"')
    print('  designs here are edited by hand like Figma: one artboard <div class="ad" style="width;height">, every piece its own')
    print('  element placed by left/top (emails too: 600px wide, one band per section). Saving a design there shows the full rules.')
    return 0

def main(a):
    if a and a[0] == "boards":
        kept_path = os.path.join(os.path.dirname(DATA), "kept.json")
        try: kept = json.load(open(kept_path))
        except Exception: kept = []
        cards = json.load(open(DATA)).get("cards", [])
        if not kept: print("No kept boards yet (pin one in Studio's board menu)."); return 0
        for k in kept:
            on = [c for c in cards if c.get("studio") == k and c["status"] != "Done"]
            print(f'{k}' + (f'  ({len(on)} active: ' + "; ".join(c["title"] for c in on) + ')' if on else ''))
        return 0
    if a and a[0] in ("remind", "reminders", "unremind"): return remind(a)
    if not a or a[0] not in ("list","start","new","done","link","studio"):
        print(__doc__.strip()); return 1
    if a[0] == "studio":
        if len(a) < 2: print("need a card id"); return 1
        return studio_board(a[1], a[2] if len(a) > 2 else None)
    with open(DATA + ".lock", "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        b = json.load(open(DATA))
        b.setdefault("brands", []); cards = b.setdefault("cards", [])
        if a[0] == "list":
            rank = {"Deep focus": 0, "Orchestrating": 1, "In progress": 1, "Next": 2}
            for c in sorted(cards, key=lambda c: (rank.get(c["status"], 3), c.get("brand",""))):
                if c["status"] != "Done":
                    print(f'{c["id"]} | {c["status"]} | {c.get("brand","")} | {c["title"]}' + (f' | studio: {c["studio"]}' + (f' / {c["studio_folder"]}' if c.get("studio_folder") else '') if c.get("studio") else ''))
            return 0
        if a[0] == "new":
            if len(a) < 2: print("need a title"); return 1
            focus = "focus" in a[2:]
            rest = [x for x in a[2:] if x != "focus"]
            brand = rest[0] if rest else ""
            if brand and brand not in b["brands"]:
                m = [x for x in b["brands"] if x.lower() == brand.lower()]
                brand = m[0] if m else (b["brands"].append(brand) or brand)
            c = {"id": "c"+hex(int(time.time()*1000))[2:], "title": a[1], "brand": brand,
                 "status": "Deep focus" if focus else "Orchestrating", "order": -1, "notes": "", "steps": [], "created": int(time.time()*1000)}
            link(c)
            cards.append(c)
        elif a[0] == "link":
            if len(a) < 4: print('usage: card link <id> "<label>" <url>'); return 1
            c = next((c for c in cards if c["id"] == a[1]), None)
            if not c: print("no card", a[1]); return 1
            label, url = a[2].replace("[","(").replace("]",")"), a[3].strip()
            if not re.match(r"https?://", url): print("url must start with http:// or https://"); return 1
            notes = c.get("notes") or ""
            if url in notes: print("already there:", url); return 0
            if "**Links**" not in notes:
                notes = notes.rstrip() + ("\n\n" if notes.strip() else "") + "**Links**\n"
            # add under the Links heading, after any links already there
            head, _, tail = notes.partition("**Links**\n")
            lines = tail.split("\n"); i = 0
            while i < len(lines) and lines[i].startswith("- ["): i += 1
            lines.insert(i, f"- [{label}]({url})")
            c["notes"] = head + "**Links**\n" + "\n".join(lines)
        else:
            if len(a) < 2: print("need a card id"); return 1
            c = next((c for c in cards if c["id"] == a[1]), None)
            if not c: print("no card", a[1]); return 1
            if a[0] == "start":
                c["status"] = "Deep focus" if "focus" in a[2:] else "Orchestrating"; c["order"] = -1; c.pop("today", None)
                c.pop("ready", None); link(c)
            elif c["status"] != "Done":
                c["ready"] = int(time.time())   # only the user decides a task is done
            else: print(f'{c["id"]} is already Done'); return 0
        import shutil; shutil.copy2(DATA, DATA + ".bak")
        h = os.path.join(os.path.dirname(DATA), "history"); os.makedirs(h, exist_ok=True)
        shutil.copy2(DATA, os.path.join(h, time.strftime("%Y%m%d-%H%M%S-") + str(time.time_ns() % 10**6) + ".json"))
        tmp = DATA + ".tmp"; json.dump(b, open(tmp, "w"), indent=1); os.replace(tmp, DATA)
        if a[0] == "link": print(f'linked on {c["id"]}: {a[2]}')
        elif a[0] == "done": print(f'{c["id"]} -> Ready for review: {c["title"]}\n  (it stays in {c["status"]} and this session stays open; the user moves it to Done)')
        else: print(f'{c["id"]} -> {c["status"]}: {c["title"]}')
    return 0
sys.exit(main(sys.argv[1:]))
